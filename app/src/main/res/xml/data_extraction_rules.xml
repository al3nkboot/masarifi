<?xml version="1.0" encoding="utf-8"?>
<!-- No Android cloud backup or device-to-device transfer of app data (financial/SMS data stays on device).
     The in-app backup/sync to a user-picked file or folder (e.g. Google Drive) is unaffected. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
